{
  "ODCS Continuity Gateway Server": {
    "prefix": "heaven-server",
    "body": [
      "// ==============================================================================",
      "// 🕊️ ${1:My Haven Continuity Gateway} (ODCS-2.0.0)",
      "// ==============================================================================",
      "",
      "import json",
      "import time",
      "import os",
      "import http.server",
      "import socketserver",
      "import urllib.parse",
      "",
      "set SERVER_NAME to \"${1:My Haven Continuity Gateway}\"",
      "remember STANDARD as \"ODCS-2.0.0\"",
      "remember DEFAULT_PORT as ${2:8000}",
      "",
      "set ledger to ContinuityLedger.open(\"haven://${3:gateway-wal}\")",
      "set crdt to PNCounter(\"${4:node-alpha}\")",
      "",
      "class HavenRequestHandler(http.server.SimpleHTTPRequestHandler):",
      "",
      "    define end_headers(self):",
      "        self.send_header(\"Access-Control-Allow-Origin\", \"*\")",
      "        self.send_header(\"X-ODCS-Standard\", STANDARD)",
      "        self.send_header(\"X-Powered-By\", \"Haven Language v2.0\")",
      "        super().end_headers()",
      "",
      "    define do_GET(self):",
      "        parsed = urllib.parse.urlparse(self.path)",
      "        path = parsed.path",
      "",
      "        whenever path is equal to \"/healthz\":",
      "            self.send_json_response(200, {",
      "                \"status\": \"HEALTHY\",",
      "                \"standard\": STANDARD,",
      "                \"merkle_height\": ledger.height()",
      "            })",
      "            give back",
      "",
      "        self.send_json_response(404, {\"error\": \"Not Found\", \"path\": path})",
      "",
      "    define send_json_response(self, code, data):",
      "        payload_bytes = json.dumps(data, indent=2).encode(\"utf-8\")",
      "        self.send_response(code)",
      "        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")",
      "        self.send_header(\"Content-Length\", str(len(payload_bytes)))",
      "        self.end_headers()",
      "        self.wfile.write(payload_bytes)",
      "",
      "class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):",
      "    daemon_threads = True",
      "    allow_reuse_address = True",
      "",
      "define start_server(port=DEFAULT_PORT):",
      "    server = ThreadedHTTPServer((\"0.0.0.0\", port), HavenRequestHandler)",
      "    say \"🕊️ Haven Gateway listening on http://0.0.0.0:{port}\"",
      "    server.serve_forever()",
      "",
      "start_server(DEFAULT_PORT)"
    ],
    "description": "Scaffold an official ODCS HTTP Continuity Gateway in Heaven Language"
  },

  "Durable Record": {
    "prefix": "heaven-record",
    "body": [
      "durable record ${1:EncounterRecord}:",
      "    ${2:record_id}: String",
      "    ${3:timestamp}: Integer",
      "    ${4:sealed_by}: String"
    ],
    "description": "Define an immutable durable record in Heaven"
  },

  "Continuity Checkpoint": {
    "prefix": "heaven-checkpoint",
    "body": [
      "set ${1:record} to ${2:EncounterRecord}(${3:\"REC-001\"}, now_ms(), \"${4:actor}\")",
      "checkpoint ${1:record} as \"${5:triage_checkpoint}\" into ${6:ledger}",
      "say \"Preserved record into Merkle block {${6:ledger}.height()} with hash {${6:ledger}.merkle_root()}\""
    ],
    "description": "Checkpoint a durable record into an append-only WAL ledger"
  },

  "Zero Intent Loss Preservation": {
    "prefix": "heaven-zil",
    "body": [
      "set receipt to ZeroIntentLoss.preserve(\"${1:USER_ACTION}\", ${2:payload}, actor=\"${3:gateway-client}\")",
      "set block to ${4:ledger}.append({\"intent\": receipt[\"intent_id\"], \"receipt_hash\": receipt[\"receipt_hash\"]})",
      "say \"Minted ZIL receipt: {receipt['receipt_id']} | Block #{block['height']}\""
    ],
    "description": "Mint a sub-16ms tamper-evident Zero Intent Loss receipt"
  },

  "CRDT PN-Counter Mesh": {
    "prefix": "heaven-crdt",
    "body": [
      "set ${1:node_counter} to PNCounter(\"${2:node-id}\")",
      "${1:node_counter}.inc(${3:1})",
      "say \"Converged CRDT mesh counter: {${1:node_counter}.value()}\""
    ],
    "description": "Create and increment a conflict-free replicated PN-counter"
  },

  "Function Definition": {
    "prefix": "heaven-fn",
    "body": [
      "define ${1:process_payload}(${2:item}, ${3:flag}=true):",
      "    whenever ${3:flag}:",
      "        give back ${1:process_payload}_internal(${2:item})",
      "    otherwise:",
      "        give back nothing"
    ],
    "description": "Define a function with natural English syntax and return"
  },

  "Whenever Conditional": {
    "prefix": "heaven-cond",
    "body": [
      "whenever ${1:status} is equal to \"${2:ONLINE}\":",
      "    say \"Node is active\"",
      "otherwise if ${1:status} is equal to \"${3:DEGRADED}\":",
      "    say \"Operating in degraded offline mode\"",
      "otherwise:",
      "    say \"Node partitioned from mesh\""
    ],
    "description": "Natural English conditional block"
  },

  "For Each Loop": {
    "prefix": "heaven-foreach",
    "body": [
      "for each ${1:item} in ${2:collection}:",
      "    say \"Processing: {${1:item}}\""
    ],
    "description": "Iterate over elements with for each"
  },

  "Repeat Loop": {
    "prefix": "heaven-repeat",
    "body": [
      "repeat ${1:5} times:",
      "    say \"Heartbeat pulse sent\""
    ],
    "description": "Repeat a block N times"
  },

  "Error Handling Block": {
    "prefix": "heaven-try",
    "body": [
      "try:",
      "    ${1:// execute operation}",
      "on error as err:",
      "    say \"[Continuity Fallback] Caught error: {err}\"",
      "always:",
      "    ${2:// cleanup resources}"
    ],
    "description": "Try / on error / always exception handling block"
  }
}

