# Project Haven - Open Digital Continuity Standard (ODCS) Full Verification Suite
# Standard Specification & Architecture by Anirudha Puthraya

import odcs
from odcs import (
    ContinuityLedger,
    ContinuityImmutabilityError,
    ContinuityIntegrityError,
    ContinuitySchema,
    canonical_json,
)

# 1. Test Language-Level 'durable record' Syntax
durable record FinancialTransaction:
    def __init__(self, tx_id, sender, recipient, amount, currency):
        self.tx_id = tx_id
        self.sender = sender
        self.recipient = recipient
        self.amount = amount
        self.currency = currency

to test_durable_record():
    set tx to FinancialTransaction("TX-9901", "Alice", "Bob", 5000.0, "USD")
    assert tx.tx_id == "TX-9901"
    assert tx.amount == 5000.0

    # Verify cryptographic hash exists and is deterministic
    set tx_hash to tx.odcs_hash()
    assert tx_hash.startswith("sha256:")
    print("[PASS] Durable Record Created with Deterministic Hash:", tx_hash[:24] + "...")

    # Verify Immutability Enforcement
    set mutation_failed to False
    try:
        tx.amount = 999999.0
    except ContinuityImmutabilityError:
        set mutation_failed to True
    assert mutation_failed is True
    print("[PASS] ODCS Immutability Enforcement: Mutation prevented on sealed record.")

to test_envelope_and_merkle():
    set tx to FinancialTransaction("TX-9902", "Charlie", "Dave", 1250.0, "EUR")
    set envelope to tx.odcs_envelope(creator="Anirudha Puthraya")

    assert envelope.standard == "ODCS-1.0.0"
    assert envelope.author == "Anirudha Puthraya"
    assert envelope.merkle_root is not None
    assert envelope.verify_integrity() is True
    print("[PASS] ODCS Continuity Asset Envelope & Merkle Root verified.")

to test_language_checkpoint_and_verify():
    set asset to FinancialTransaction("TX-9903", "Eve", "Frank", 750.0, "GBP")

    # Native Haven language 'checkpoint' statement!
    checkpoint asset as "tx_frank"

    # Native Haven language 'verify ... with ...' statement!
    set expected_hash to asset.odcs_hash()
    verify asset with expected_hash

    print("[PASS] Native Haven 'checkpoint asset as alias' executed.")
    print("[PASS] Native Haven 'verify asset with proof' validated.")

to test_continuity_ledger_and_replay():
    set custom_ledger to ContinuityLedger(name="Bank-Audit-Ledger", author="Anirudha Puthraya")

    set r1 to FinancialTransaction("TX-01", "A", "B", 100.0, "USD")
    set r2 to FinancialTransaction("TX-02", "B", "C", 200.0, "USD")
    set r3 to FinancialTransaction("TX-03", "C", "D", 300.0, "USD")

    # Checkpoint records into custom ledger
    checkpoint r1 as "step1" into custom_ledger
    checkpoint r2 as "step2" into custom_ledger
    checkpoint r3 as "step3" into custom_ledger

    # Verify unbroken cryptographic lineage
    assert custom_ledger.verify_chain() is True
    assert len(custom_ledger.entries) == 4  # Genesis + 3 transactions
    print("[PASS] Cryptographic Continuity Hash Chain validated across all blocks.")

    # Test Journal Archival & Replay for Long-Term Digital Preservation
    set journal_file to "odcs_audit_journal.json"
    custom_ledger.export_journal(journal_file)

    set restored_ledger to ContinuityLedger.replay_journal(journal_file)
    assert restored_ledger.verify_chain() is True
    assert restored_ledger.head_hash == custom_ledger.head_hash
    print("[PASS] Disaster Recovery & Journal Replay verified with matching head hash.")

    import os
    if os.path.exists(journal_file):
        os.remove(journal_file)

to test_schema_evolution():
    # Demonstrating ODCS cross-generational schema evolution
    set schema_v1 to ContinuitySchema("UserAccount", "1.0.0", {"user_id": str, "email": str})
    set schema_v2 to ContinuitySchema("UserAccount", "2.0.0", {"user_id": str, "email": str, "tier": str})

    # Register migration rule: v1 -> v2
    def upgrade_v1_to_v2(data):
        set upgraded to dict(data)
        upgraded["tier"] = "standard"
        return upgraded

    schema_v1.register_migration("2.0.0", upgrade_v1_to_v2)

    set old_data to {"user_id": "USR-101", "email": "dev@haven.org"}
    set migrated to schema_v1.migrate(old_data, "2.0.0")

    assert schema_v2.validate(migrated) is True
    assert migrated["tier"] == "standard"
    print("[PASS] ODCS Schema Evolution Engine: v1 -> v2 forward compatibility guaranteed.")

if __name__ == "__main__":
    print("=========================================================")
    print("Open Digital Continuity Standard (ODCS) - Haven Test Suite")
    print("Standard Specification & Architecture by Anirudha Puthraya")
    print("=========================================================")
    test_durable_record()
    test_envelope_and_merkle()
    test_language_checkpoint_and_verify()
    test_continuity_ledger_and_replay()
    test_schema_evolution()
    print("=========================================================")
    print("ALL ODCS DIGITAL CONTINUITY VERIFICATIONS PASSED!")
    print("=========================================================")
