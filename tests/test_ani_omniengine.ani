variable info_map = engine.info()
ensure info_map["version"] == "3.0.0-HYPER" otherwise "Engine version mismatch"
ensure info_map["timeline_nodes"] >= 1 otherwise "Missing timeline nodes in engine info"

# Verify AniApp and AniServer aliases
variable test_app = AniApp("AniCommerceEngine", port=9991)
ensure test_app.name == "AniCommerceEngine" otherwise "AniApp instantiation failed"

