# Ani++ / Haven All-Field Superpowers Verification Suite
# Tests Scientific Matrix & DataFrame, Robotics PID & Kalman, Cyber Vault & PBFT Consensus

from ani import (
    Matrix,
    Series,
    DataFrame,
    PIDController,
    KalmanFilter,
    CircularRingBuffer,
    CyberVault,
    ByzantineConsensus,
    SandboxedProcess,
)

def test_scientific_matrix():
    # 2x2 Matrix Inversion and Multiplication
    m1 = Matrix([[1.0, 2.0], [3.0, 4.0]])
    det = m1.determinant()
    assert abs(det - (-2.0)) < 1e-6, f"Determinant error: {det}"

    inv = m1.inverse()
    ident = m1 @ inv
    assert abs(ident.get(0, 0) - 1.0) < 1e-5
    assert abs(ident.get(1, 1) - 1.0) < 1e-5
    assert abs(ident.get(0, 1)) < 1e-5
    assert abs(ident.get(1, 0)) < 1e-5

    # Transposition and Trace
    m_trans = m1.transpose()
    assert m_trans.get(0, 1) == 3.0
    assert m1.trace() == 5.0
    print("✓ Scientific Matrix linear algebra fully verified")

def test_scientific_dataframe():
    records = [
        {"sensor": "gyro_x", "reading": 12.5, "status": "nominal"},
        {"sensor": "gyro_y", "reading": 18.2, "status": "nominal"},
        {"sensor": "gyro_z", "reading": 45.0, "status": "warning"},
        {"sensor": "temp",   "reading": 88.0, "status": "critical"}
    ]
    df = DataFrame.from_dicts(records)
    assert df.shape == (4, 3)

    # Filtering
    nominal_df = df.where("status", lambda s: s == "nominal")
    assert nominal_df.shape == (2, 3)

    # Series Statistics
    readings = df.column("reading")
    assert readings.mean() == (12.5 + 18.2 + 45.0 + 88.0) / 4.0
    assert readings.max() == 88.0

    # CSV output
    csv_str = df.to_csv()
    assert "gyro_x" in csv_str
    print("✓ Scientific DataFrame columnar operations fully verified")

def test_robotics_pid_controller():
    pid = PIDController(kp=1.5, ki=0.5, kd=0.1, setpoint=100.0, output_limits=(-50.0, 50.0))
    action1 = pid.update(current_value=0.0, dt=0.1)
    assert action1 == 50.0  # Clamped to max limit

    # Closer to setpoint
    action2 = pid.update(current_value=95.0, dt=0.1)
    assert action2 < 50.0
    print("✓ Robotics PID Controller real-time feedback fully verified")

def test_robotics_kalman_filter():
    kf = KalmanFilter(initial_state=0.0, process_variance=1e-4, measurement_variance=0.1)
    # Series of noisy measurements around true value 10.0
    noisy_measurements = [9.8, 10.2, 9.9, 10.1, 10.05]
    estimated = 0.0
    for z in noisy_measurements:
        estimated = kf.update(z)

    # Filtered estimate should be close to 10.0
    assert abs(estimated - 10.0) < 0.5
    print("✓ Robotics Kalman Filter noise reduction fully verified")

def test_robotics_ring_buffer():
    buf = CircularRingBuffer(capacity=5)
    for i in range(10):
        buf.push(float(i))

    assert len(buf) == 5
    items = buf.to_list()
    assert items == [5.0, 6.0, 7.0, 8.0, 9.0]
    assert buf.mean() == 7.0
    assert buf.peak_to_peak() == 4.0
    print("✓ Robotics Circular Ring Buffer streaming telemetry fully verified")

def test_cyber_authenticated_vault():
    vault = CyberVault()
    secret_payload = {"account": "BANK_CORP", "reserve_usd": 15000000.0, "status": "SOVEREIGN"}

    envelope = vault.seal(secret_payload, context="banking:reserve")
    assert "auth_tag" in envelope
    assert "nonce" in envelope

    decrypted = vault.unseal(envelope, context="banking:reserve")
    assert decrypted["reserve_usd"] == 15000000.0

    # Tamper with ciphertext
    tampered = dict(envelope)
    tampered["ciphertext"] = "AAAA" + tampered["ciphertext"][4:]
    tamper_caught = False
    try:
        vault.unseal(tampered, context="banking:reserve")
    except PermissionError:
        tamper_caught = True
    assert tamper_caught, "Failed to catch cryptographic ciphertext tampering!"
    print("✓ Cyber Vault cryptographic sealing & anti-tamper fully verified")

def test_cyber_byzantine_consensus():
    cluster = ["node-0", "node-1", "node-2", "node-3"]  # N=4, f=1, 2f+1=3
    pbft = ByzantineConsensus(node_id="node-0", cluster_nodes=cluster)

    tx = {"action": "SOVEREIGN_TRANSFER", "amount": 50000, "from": "treasury", "to": "defense"}
    pre_prep = pbft.propose(tx)
    seq = pre_prep["seq"]
    digest = pre_prep["digest"]

    # Receive prepares from 2 other nodes (total 3 including leader = quorum)
    q1 = pbft.receive_prepare("node-1", seq, digest)
    assert not q1  # only 2 prepares
    q2 = pbft.receive_prepare("node-2", seq, digest)
    assert q2  # 3 prepares reached (node-0, node-1, node-2)

    # Receive commits
    pbft.receive_commit("node-0", seq, digest)
    pbft.receive_commit("node-1", seq, digest)
    committed = pbft.receive_commit("node-2", seq, digest)
    assert committed
    assert pbft.is_committed(seq)
    assert len(pbft.ledger) == 1
    print("✓ Cyber Byzantine Fault Tolerant (PBFT) consensus fully verified")

def test_cyber_sandboxed_process():
    cmd = ["cmd.exe", "/c", "echo", "SOVEREIGN_SUPERPOWER"]
    sandbox = SandboxedProcess(cmd, timeout_s=3.0)
    res = sandbox.execute()
    assert res["success"]
    assert "SOVEREIGN_SUPERPOWER" in res["stdout"]
    assert len(res["receipt_hash"]) == 64
    print("✓ Cyber Sandboxed Process execution and audit hashing fully verified")

if __name__ == "__main__":
    test_scientific_matrix()
    test_scientific_dataframe()
    test_robotics_pid_controller()
    test_robotics_kalman_filter()
    test_robotics_ring_buffer()
    test_cyber_authenticated_vault()
    test_cyber_byzantine_consensus()
    test_cyber_sandboxed_process()
    print("\n=======================================================")
    print("ALL 8 ALL-FIELD INDUSTRIAL SUPERPOWER SUITES PASSED! 🚀")
    print("=======================================================")
