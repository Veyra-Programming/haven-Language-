{
  "name": "haven-language",
  "displayName": "Haven Programming Language",
  "description": "Official Visual Studio Code extension for Haven Language: natural-English syntax highlighting, Haven Fox mascot branding, autocompletion, hover signatures, and ODCS digital continuity integration.",
  "version": "2.1.0",
  "publisher": "star-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veyra-Programming/haven-Language-"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "assets/logo.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "haven",
    "heaven",
    "fox",
    "natural-english",
    "odcs",
    "ofcs",
    "digital-continuity",
    "crdt",
    "zero-intent-loss",
    "hvn"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:haven",
    "onLanguage:heaven",
    "workspaceContains:**/*.hvn",
    "workspaceContains:**/*.haven"
  ],
  "contributes": {
    "languages": [
      {
        "id": "haven",
        "aliases": [
          "Haven",
          "haven",
          "Heaven",
          "heaven"
        ],
        "extensions": [
          ".hvn",
          ".haven"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/file_icon.png",
          "dark": "./assets/file_icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "haven",
        "scopeName": "source.haven",
        "path": "./syntaxes/haven.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "haven",
        "path": "./snippets/haven.json"
      }
    ],
    "commands": [
      {
        "command": "haven.run",
        "title": "Haven: Run Active File",
        "icon": "$(play)"
      },
      {
        "command": "haven.test",
        "title": "Haven: Run Test Suites",
        "icon": "$(beaker)"
      },
      {
        "command": "haven.lint",
        "title": "Haven: Lint & Validate Syntax",
        "icon": "$(check)"
      },
      {
        "command": "haven.startServer",
        "title": "Haven: Start ODCS Continuity Server",
        "icon": "$(server)"
      },
      {
        "command": "haven.repl",
        "title": "Haven: Launch Interactive REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "haven.showMenu",
        "title": "Haven: Show Actions Menu"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "haven.run",
          "when": "editorLangId == haven",
          "group": "navigation@1"
        },
        {
          "command": "haven.test",
          "when": "editorLangId == haven",
          "group": "navigation@2"
        },
        {
          "command": "haven.lint",
          "when": "editorLangId == haven",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "haven.run",
          "when": "resourceExtname == .hvn || resourceExtname == .haven",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Haven Language",
      "properties": {
        "haven.runnerPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to haven executable binary."
        }
      }
    }
  }
}
