{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Haven",
  "scopeName": "source.haven",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#odcs_keywords" },
    { "include": "#english_syntax" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#odcs_builtins" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.haven",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.haven",
          "begin": "('''|\"\"\")",
          "end": "\\1"
        },
        {
          "name": "string.quoted.double.haven",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.haven", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.haven",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.haven", "match": "\\\\." }
          ]
        }
      ]
    },
    "odcs_keywords": {
      "patterns": [
        {
          "name": "keyword.control.odcs.haven",
          "match": "\\b(checkpoint|verify|durable\\s+(?:record|class))\\b"
        },
        {
          "name": "keyword.operator.odcs.haven",
          "match": "\\b(as|with|into)\\b"
        }
      ]
    },
    "english_syntax": {
      "patterns": [
        {
          "name": "keyword.control.english.haven",
          "match": "\\b(set|to|let|be|unless|until|repeat|times|time|function|pipe|into)\\b"
        },
        {
          "name": "keyword.control.english.for-each.haven",
          "match": "\\bfor\\s+each\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.haven",
          "match": "\\b(if|elif|else|while|for|in|try|except|finally|raise|return|yield|pass|break|continue|assert|with|match|case)\\b"
        },
        {
          "name": "keyword.operator.logical.haven",
          "match": "\\b(and|or|not|is|in)\\b"
        },
        {
          "name": "constant.language.haven",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.haven",
          "match": "(\\|>|into)"
        },
        {
          "name": "keyword.operator.comparison.haven",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.haven",
          "match": "(\\+|\\-|\\*|\\/|\\/\\/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.assignment.haven",
          "match": "(=|\\+=|\\-=|\\*=|\\/=)"
        }
      ]
    },
    "odcs_builtins": {
      "patterns": [
        {
          "name": "support.class.odcs.haven",
          "match": "\\b(ContinuityLedger|VectorClock|LWWRegister|PNCounter|AWORSet|MeshNode|GossipMesh|ContinuityMode|EnvironmentalTelemetry|IntentReceipt|ZeroIntentLossManager|DurableRecord|ContinuityAssetEnvelope|MerkleTree|ODCSApp|ContinuityAlgorithm)\\b"
        },
        {
          "name": "support.function.odcs.haven",
          "match": "\\b(durable_record|checkpoint|verify_continuity|adaptive_policy|get_default_ledger|canonical_json|compute_sha256)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.haven",
          "match": "\\b(?:def|function|to)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.haven",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    }
  }
}

